# Neon (Postgres) — free tier — required on Vercel
# Get connection string from https://console.neon.tech → Connection string
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DB?sslmode=require

# API auth
JWT_SECRET=your-random-secret-at-least-32-chars
SETUP_SECRET=your-setup-secret-for-one-time-db-setup
ADMIN_USERNAME=admin
ADMIN_PASSWORD=geheny2024
# Or use a pre-generated bcrypt hash instead of ADMIN_PASSWORD:
# ADMIN_PASSWORD_HASH=

# Enable API (set on Vercel)
VITE_API_ENABLED=true
# Optional — local API testing with vercel dev
# VITE_API_BASE=http://localhost:3000
# Optional — used by scripts/run-setup.mjs
# SITE_URL=https://el-geheny.vercel.app
