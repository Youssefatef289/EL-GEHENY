# PlanetScale (MySQL) — required on Vercel
DATABASE_HOST=aws.connect.psdb.cloud
DATABASE_USERNAME=your-planetscale-username
DATABASE_PASSWORD=your-planetscale-password

# API auth
JWT_SECRET=your-random-secret-at-least-32-chars
SETUP_SECRET=your-setup-secret-for-one-time-db-setup
ADMIN_USERNAME=admin
ADMIN_PASSWORD=geheny2024
# Or use a pre-generated bcrypt hash instead of ADMIN_PASSWORD:
# ADMIN_PASSWORD_HASH=

# Enable PlanetScale API (set on Vercel)
VITE_API_ENABLED=true
# Optional — local API testing with vercel dev
# VITE_API_BASE=http://localhost:3000
